---
layout: layouts/base.njk
---
<div class="home-intro">
{{ content | safe }}
</div>

{% set entries = collections.entry | reverse %}
{% if entries.length %}
<section aria-labelledby="writing-label">
  <h2 class="section-label" id="writing-label">Writing &amp; notes</h2>
  <ul class="stream">
    {%- for post in entries | limit(5) %}
    <li>
      <time datetime="{{ post.date.toISOString() | slice(0, 10) }}">{{ post.date | dateShort }}</time>
      <div>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p class="entry-meta">{{ post.data.kind | title }}{% if post.data.author %} · {{ post.data.author }}{% endif %}</p>
      </div>
    </li>
    {%- endfor %}
  </ul>
</section>
{% endif %}

{% if collections.projectsSorted.length %}
<section aria-labelledby="projects-label">
  <h2 class="section-label" id="projects-label">Projects</h2>
  <ul class="projects">
    {%- for project in collections.projectsSorted %}
    <li>
      <span class="name">{% if project.data.repo %}<a href="{{ project.data.repo }}">{{ project.data.name }}</a>{% else %}{{ project.data.name }}{% endif %}</span>
      — {{ project.data.blurb }}
      <span class="status {{ project.data.status }}">{{ project.data.status }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>
{% endif %}
